{
    "name": "dynamic-text-anchors",
    "description": "Dynamic Text Anchors",
    "keywords": [
        "dynamic",
        "text",
        "anchor"
    ],
    "version": "3.0.0",
    "author": "Petr Chalupa",
    "license": "SEE LICENSE IN LICENSE.md",
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/lib/core/index.d.ts",
            "import": "./dist/lib/core/index.js"
        },
        "./*": {
            "types": "./dist/*/index.d.ts",
            "import": "./dist/*/index.js"
        }
    },
    "files": [
        "dist/lib/",
        "LICENSE.md",
        "README.md",
        "package.json"
    ],
    "scripts": {
        "demo-dev": "vite --config ./demo/vite.config.js",
        "build-demo": "vite build --emptyOutDir --config ./demo/vite.config.js",
        "build-lib": "tsc --build ./lib/tsconfig.json",
        "build-lib-watch": "tsc --build ./lib/tsconfig.json --watch",
        "version-patch": "npm version patch -m \"Upgrade to version %s\"",
        "version-minor": "npm version minor -m \"Upgrade to version %s\"",
        "version-major": "npm version major -m \"Upgrade to version %s\"",
        "postversion": "git push --follow-tags"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^6.0.9",
        "@vue/tsconfig": "^0.9.1",
        "typescript": "^7.0.2",
        "vite": "^8.3.0",
        "vue": "^3.5.42",
        "vue-tsc": "^3.3.11"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Petr-Chalupa/DynamicTextAnchors.git"
    },
    "bugs": {
        "url": "https://github.com/Petr-Chalupa/DynamicTextAnchors/issues"
    },
    "homepage": "https://petr-chalupa.github.io/DynamicTextAnchors"
}
